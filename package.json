{
  "name": "maaroof-editorial-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "server": "node --env-file-if-exists=.env server/main.mjs",
    "dev:api": "node --env-file-if-exists=.env server/main.mjs",
    "browser:worker": "node --env-file-if-exists=.env server/browser-worker.mjs",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "mammoth": "1.13.0",
    "pdf-parse": "1.1.1",
    "playwright": "1.64.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "10.4.21",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.16",
    "@rolldown/binding-win32-x64-msvc": "1.2.16"
  }
}
