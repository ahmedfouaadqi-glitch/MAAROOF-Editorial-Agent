# Standalone Node API (no Supabase, no Firecrawl)
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
ADMIN_API_TOKEN=replace-with-a-long-random-secret
DATA_FILE=./data/editorial-agent.json

# Frontend API base URL (public URL only; never put ADMIN_API_TOKEN here)
VITE_API_BASE_URL=http://localhost:8787

# Optional live research provider. The API remains disabled until both values are configured.
# Every explicit search request may incur charges under the selected provider plan.
RESEARCH_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
