# Standalone Node API (Supabase excluded; Firecrawl is optional)
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
ADMIN_API_TOKEN=replace-with-a-long-random-secret
DATA_FILE=./data/editorial-agent.json

# Frontend API base URL (public URL only; never put ADMIN_API_TOKEN here)
VITE_API_BASE_URL=http://localhost:8787

# Optional Firecrawl v2 provider. Keep this key server-side only.
# Scraping is enabled when FIRECRAWL_API_KEY is configured.
# Search uses Firecrawl only when RESEARCH_SEARCH_PROVIDER=firecrawl.
FIRECRAWL_API_KEY=
RESEARCH_SEARCH_PROVIDER=
# Allowed search provider values: firecrawl, brave, or empty (disabled).
BRAVE_SEARCH_API_KEY=

# Article-writing model integration is deferred and disabled by default.
# Do not enable until the model provider, costs and user approval are configured.
ENABLE_MODEL_GENERATION=false
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_OUTPUT_TOKENS=3000
MODEL_REQUESTS_PER_ARTICLE=2
