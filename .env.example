# Standalone Node API (Supabase excluded; Firecrawl is optional)
PORT=8787
HOST=127.0.0.1
# Keep false for local use. Remote bind requires a strong ADMIN_API_TOKEN, trusted TLS reverse proxy, and firewall.
API_ALLOW_REMOTE=false
# Exact comma-separated frontend origins only; no wildcard. Example: https://project.lovable.app,https://editor.example.com
CORS_ORIGIN=http://localhost:5173
# Generate with `openssl rand -hex 32` (or another cryptographically secure generator).
# Leave blank for a loopback-only API; the UI will explain that admin access is not configured.
ADMIN_API_TOKEN=
DATA_FILE=./data/editorial-agent.json
MEDIA_DIR=./data/media

# Frontend API base URL (public URL only; never put ADMIN_API_TOKEN here)
VITE_API_BASE_URL=http://localhost:8787

# Optional Firecrawl v2 provider. Keep this key server-side only.
# Scraping is enabled when FIRECRAWL_API_KEY is configured.
# Search uses Firecrawl only when RESEARCH_SEARCH_PROVIDER=firecrawl.
FIRECRAWL_API_KEY=
RESEARCH_SEARCH_PROVIDER=
# Allowed search provider values: firecrawl, brave, or empty (disabled).
BRAVE_SEARCH_API_KEY=

# Independent OpenAI-compatible provider for chat generation (server-side only).
# If these are absent, conversations still save but generation returns a clear unavailable notice.
# The model provider may receive the prompt and selected attachment context; it never connects to MAAROOF AI.
PLATFORM_CONTENT_GENERATION_ENABLED=false
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_OUTPUT_TOKENS=3000

# Private browser worker. Run npm run browser:worker separately after npm run browser:install.
# Generate a second independent secret with `openssl rand -hex 32`; never use a placeholder token.
# Keep the worker on loopback. Remote bind requires explicit opt-in and a trusted TLS reverse proxy/firewall.
# API and worker must use the same BROWSER_AGENT_TOKEN.
# Worker automatically runs an IP-pinning CONNECT proxy on 127.0.0.1; keep direct container egress blocked where supported.
BROWSER_AGENT_HOST=127.0.0.1
BROWSER_AGENT_ALLOW_REMOTE=false
BROWSER_AGENT_PORT=8788
BROWSER_AGENT_URL=http://127.0.0.1:8788
BROWSER_AGENT_TOKEN=
